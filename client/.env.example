# Backend API URL (for local dev: http://localhost:5000/api; for Vercel deployment: https://your-backend.onrender.com/api)
VITE_API_URL=https://your-backend.onrender.com/api

# Realtime WebSocket URL (optional, defaults automatically to VITE_API_URL host if omitted)
VITE_WS_URL=https://your-backend.onrender.com

# Optional Mapbox Access Token for satellite/vector styles (free OpenFreeMap/Carto styles used by default)
VITE_MAPBOX_TOKEN=
