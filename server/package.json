{
  "name": "geofit-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "verify": "node scripts/verify-engine.js",
    "test:engine": "node scripts/verify-engine.js",
    "test:phase6": "node scripts/test-phase6-challenges.js",
    "test:phase7": "node scripts/test-phase7-competition.js",
    "test:phase8": "node scripts/test-phase8-realtime.js",
    "test:phase9": "node scripts/test-phase9-anticheat.js",
    "test:phase10": "node scripts/test-phase10-gamification.js",
    "test:phase11": "node scripts/test-phase11-privacy.js",
    "test:phase12": "node scripts/test-phase12-demo.js",
    "test:phase13": "node scripts/test-phase13-audit.js",
    "test:all": "npm run verify && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13"
  },
  "dependencies": {
