# Port (Render sets this automatically; defaults to 5000 in local dev)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Frontend Client URL (e.g. https://your-frontend.vercel.app or http://localhost:5173 for local dev)
CLIENT_URL=https://your-frontend.vercel.app

# Optional PostgreSQL Database URL. If left empty, GeoFit automatically uses the local SQLite engine in server/data/geofit.db
DATABASE_URL=

# Automatic SQLite fallback flag (set to 'true' to allow seamless local SQLite usage)
USE_SQLITE_FALLBACK=true

# Secret key for JWT session tokens (set to any random 32+ character string in Render)
JWT_SECRET=your_jwt_secret_key_here
